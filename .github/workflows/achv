name: ACHV SEC Monitor

on:
  schedule:
    # Runs every 15 minutes, Monday through Friday
    - cron: '*/15 * * * 1-5'
  workflow_dispatch: # Adds a button to the GitHub UI so you can trigger it manually to test it

jobs:
  monitor:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: pip install feedparser requests

      - name: Run ACHV Monitor
        env:
          # This securely pulls your existing NTFY_TOPIC secret
          NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
        run: python monitor_achv.py

      - name: Commit state file changes
        # This saves the state file back to the repo so you don't get duplicate alerts
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          git add achv_state.json
          git diff-index --quiet HEAD || (git commit -m "Update ACHV state" && git push)
